# ── AgentPay — environment template ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Deployer / Owner wallet ───────────────────────────────────────────────────
# The private key of the wallet that deploys the contract and funds it.
# This wallet becomes "owner" in the contract.
DEPLOYER_PRIVATE_KEY=0x_YOUR_DEPLOYER_PRIVATE_KEY_HERE

# ── Agent wallet ──────────────────────────────────────────────────────────────
# The PUBLIC address of the AI agent wallet (Person 2).
# The private key for this address is held ONLY by Person 2's agent code.
AGENT_ADDRESS=0x_AGENT_PUBLIC_ADDRESS_HERE

# ── Hard spending cap ─────────────────────────────────────────────────────────
# Maximum lifetime spend enforced by the contract, in wei.
# Default: 0.01 ETH = 10000000000000000 wei
HARD_SPENDING_CAP_WEI=10000000000000000

# ── Initial funding amount ────────────────────────────────────────────────────
# How much ETH to send to the contract during deployment, in wei.
# Must be <= available balance; can be topped up later via fund().
INITIAL_FUND_WEI=10000000000000000

# ── RPC / Infura / Alchemy ────────────────────────────────────────────────────
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY_HERE

# ── Etherscan (optional, for contract verification) ───────────────────────────
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY_HERE
