# ── AgentPay Frontend — Environment Variables ────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env (with real values) to version control.
#
# All variables prefixed with VITE_ are safe for the browser bundle.
# Do NOT add private keys, seed phrases, or agent signing keys here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required: AgentPay Contract Address ───────────────────────────────────────
# Obtained from: Blockchain/artifacts-export/deployment.json → contractAddress
# Must be a valid checksummed Sepolia EVM address (0x + 40 hex chars).
# The frontend will refuse to start if this is missing or invalid.
VITE_CONTRACT_ADDRESS=0x<LIVE_SEPOLIA_CONTRACT_ADDRESS>

# ── Required: Ethereum Chain ID ───────────────────────────────────────────────
# Sepolia Testnet = 11155111
# The frontend validates the connected network against this value.
VITE_CHAIN_ID=11155111

# ── Optional: Public RPC URL ──────────────────────────────────────────────────
# A public, key-free RPC endpoint for read-only contract queries.
# Fallback: https://rpc.sepolia.org (public, may be rate-limited)
# For production: use a dedicated Infura/Alchemy public endpoint.
# WARNING: Do NOT put a private Infura/Alchemy key here — use a restricted key
# or the public endpoint. This value is bundled into the frontend JS.
VITE_PUBLIC_RPC_URL=https://rpc.sepolia.org

# ── Optional: Block Explorer URL ─────────────────────────────────────────────
VITE_BLOCK_EXPLORER_URL=https://sepolia.etherscan.io

# ── Optional: Backend API Base URL (Person 2 AI Agent / Person 3 Provider) ───
# Only needed when Person 2 or Person 3 backends are deployed.
# VITE_API_BASE_URL=https://your-agentpay-backend.onrender.com
