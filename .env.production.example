# ── AgentPay — Production Environment Configuration (Render / Cloud) ──────────
# Copy this to the Render Environment Variables tab or your production .env.
# NEVER commit actual secrets, private keys, or RPC credentials to source control.

# ── 1. Contract Coordinates (REQUIRED) ────────────────────────────────────────
# The live Sepolia contract address deployed via scripts/deploy.js
CONTRACT_ADDRESS=0xYOUR_LIVE_SEPOLIA_CONTRACT

# Sepolia Network Chain ID (Strictly enforced: 11155111)
CHAIN_ID=11155111

# ── 2. Sepolia RPC Provider (REQUIRED) ────────────────────────────────────────
# JSON-RPC endpoint for Ethereum Sepolia (e.g. Infura, Alchemy, or QuickNode)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# ── 3. AI Agent Wallet (REQUIRED FOR AGENT / BACKEND SIGNING ONLY) ─────────────
# Private key of the AI Agent (Person 2) authorized in the AgentPay contract.
# WARNING: NEVER expose this to frontend clients, browser code, or public repos.
AGENT_PRIVATE_KEY=DO_NOT_COMMIT

# ── 4. Server Configuration (Render Standard) ─────────────────────────────────
# Render automatically sets PORT. Default fallback is 10000.
PORT=10000
NODE_ENV=production
