{
  "name": "agentpay-blockchain",
  "version": "1.0.0",
  "description": "AgentPay smart contract — Ethereum Sepolia. Enforces hard spending cap for AI agent payments.",
  "scripts": {
    "build": "hardhat compile && node scripts/exportAbi.js",
    "start": "node server.js",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "export-abi": "node scripts/exportAbi.js",
    "clean": "hardhat clean"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.6.1",
    "hardhat": "^2.22.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0"
  }
}
